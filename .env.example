# NullTrace AI — example environment configuration.
# Copy to .env (never commit a real .env) and export in the shell that
# runs the backend. No real secrets belong in this file.

# --- Web platform -----------------------------------------------------

# SQLite database location for the web platform (default: data/nulltrace.db).
#NULLTRACE_DB_PATH=data/nulltrace.db

# Path to the built frontend (default: frontend/dist).
#NULLTRACE_FRONTEND_DIST=frontend/dist

# Optional shared token guarding the dashboard API. When set, every /api
# request (except /api/health and /api/version) must send it in the
# X-API-Token header. The dashboard Settings page stores it per browser
# session. Keep the server bound to 127.0.0.1 regardless.
#NULLTRACE_API_TOKEN=choose-a-long-random-value

# --- Assessment targets ------------------------------------------------

# API keys for OpenAI-compatible targets are read from whichever
# environment variable each target names (default OPENAI_API_KEY).
# They are never stored in the database, sent to the browser, logged,
# or written into reports.
#OPENAI_API_KEY=sk-your-key-here-never-commit-it
